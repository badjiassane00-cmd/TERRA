# ===========================================
# TERRA - Configuration des APIs
# ===========================================

# Google Gemini — identification multimodale des espèces + assistant vocal.
# Créer une clé sur https://aistudio.google.com/apikey. Secret côté serveur.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.7-flash

# Assistant vocal (option payante, seulement si GEMINI_API_KEY absente)
# Obtenir une clé sur https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Statut de conservation (optionnel) — sans cette clé, le badge de
# conservation ne s'affiche simplement pas, rien ne casse.
# Créer un compte gratuit sur https://api.iucnredlist.org/
IUCN_API_KEY=

# Identification botanique — Pl@ntNet
# Créez une clé sur https://my.plantnet.org/ puis ne la rendez jamais publique.
PLANTNET_API_KEY=

# Diagnostic des maladies végétales — microservice open source PlantVillage EfficientNet-B4
# Démarrer avec : docker compose up -d plant-disease
DISEASE_MODEL_URL=http://127.0.0.1:8010

# Reconnaissance des animaux et insectes — modèle ouvert BioCLIP Imageomics
# Démarrer avec : docker compose up -d --build bioclip
BIOCLIP_API_URL=http://127.0.0.1:8020

# API météo pour les rappels intelligents (OpenWeatherMap)
# Obtenir une clé sur https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Identification sonore (service d’analyse compatible, hébergé séparément)
# L’endpoint reçoit un POST multipart/form-data avec le champ "audio".
SOUND_IDENTIFICATION_API_URL=
SOUND_IDENTIFICATION_API_KEY=

# Cartes et géolocalisation (Google Maps - optionnel)
# Obtenir une clé sur https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=

# Traduction et reconnaissance vocale (optionnel)
# Obtenir une clé sur https://cloud.google.com/translate
GOOGLE_TRANSLATE_API_KEY=

# Stockage d'images (Cloudinary - optionnel)
# Obtenir une clé sur https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Authentification (NextAuth - optionnel)
# Générer avec: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Base de données MySQL (PostgreSQL source conservée lors de la transition)
# Format : mysql://utilisateur:mot-de-passe@hôte:3306/base
# Base de données MySQL (obligatoire — SQLite ne tient pas la
# charge en production avec des écritures concurrentes : scans,
# sessions de terrain en direct, likes communautaires...).
# Pour MySQL en développement local : docker compose up -d mysql
# URL locale :

DATABASE_URL="mysql://<utilisateur>:<mot-de-passe>@127.0.0.1:3309/terra"
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=terra
MYSQL_USER=
MYSQL_PASSWORD=
# Facultatif : ancienne PostgreSQL, uniquement pour le transfert ponctuel sans suppression
LEGACY_POSTGRES_URL=""

# MinIO AIStor local (remplir avec des secrets générés, jamais les publier)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Médias S3/MinIO utilisés par TERRA
MEDIA_S3_ENDPOINT="http://127.0.0.1:9000"
MEDIA_S3_REGION="us-east-1"
MEDIA_S3_BUCKET="terra-media"
MEDIA_S3_ACCESS_KEY=""
MEDIA_S3_SECRET_KEY=""
MEDIA_S3_FORCE_PATH_STYLE="true"

# JWT pour l'authentification — obligatoire, aucune valeur par défaut
# Générer avec: openssl rand -base64 32
JWT_SECRET=

# Monitoring (optionnel)
SENTRY_DSN=

# Analytics (optionnel)
NEXT_PUBLIC_GA_ID=

# Notifications communautaires (facultatives)
# E-mail transactionnel via https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=SunuNature <notifications@votre-domaine.example>
# URL publique utilisée dans les liens de notification
APP_URL=http://localhost:3000

# SMS et WhatsApp via Twilio Programmable Messaging
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+221XXXXXXXXX
TWILIO_WHATSAPP_FROM=+14155238886
# SID d'un modèle WhatsApp approuvé, avec variables {{1}} (titre) et {{2}} (message)
TWILIO_WHATSAPP_CONTENT_SID=
